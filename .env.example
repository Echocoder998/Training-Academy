# ─── Database (Neon) ───────────────────────────────────────────
# Neon dashboard → your project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Sign-in (optional) ────────────────────────────────────────
# Leave ALL of these empty for TEST MODE: no login, each browser gets its own tester profile, everyone is admin.
# Sign-in turns on as soon as ACCESS_CODE or the AUTH_MICROSOFT_ENTRA_ID_* settings are set.
# Generate with:  npx auth secret
AUTH_SECRET=""
# Azure portal → Microsoft Entra ID → App registrations → your app
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<YOUR-TENANT-ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Quick start (before Microsoft sign-in is set up): team signs in with work email + this shared code.
# Pick something long, share it only with your team, and change it if it leaks.
ACCESS_CODE=""
# Only these email domains can use the access code, e.g. "dasco.com,mceautomation.com"
ALLOWED_EMAIL_DOMAINS=""
# Comma-separated emails that get Manage + Team results access
ADMIN_EMAILS="you@company.com"
# Local testing only: shows a "sign in with email" box with no password. NEVER enable in production.
AUTH_DEV_LOGIN="false"

# ─── AI (Anthropic Claude: role-play customer, grading, quiz writer) ───
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=""
# Customer replies in role-play (fast, low cost)
ANTHROPIC_MODEL_FAST="claude-haiku-5-5"
# Grading calls and writing quiz questions
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ─── Voice practice (ElevenLabs) ───────────────────────────────
ELEVENLABS_AGENT_ID="agent_9401m5wj7gdrfbzvrxvt8pjf939w"
# Optional but recommended: lets the server create private session links,
# so you can turn on "Enable authentication" for the agent in ElevenLabs.
ELEVENLABS_API_KEY=""

# ─── Video storage (Vercel Blob) ───────────────────────────────
# Vercel → Storage → Create Blob store → connect to project (adds this automatically)
BLOB_READ_WRITE_TOKEN=""
